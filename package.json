{
  "name": "nexamiro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted workspace for multi-agent AI tasks and private knowledge.",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "node --env-file-if-exists=.env backend/gateway.js",
    "dev:web": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env backend/gateway.js",
    "test": "node --test tests/*.test.js",
    "mcp": "node --env-file-if-exists=.env backend/mcp-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "lucide-react": "0.562.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "vite": "7.3.6"
  }
}
