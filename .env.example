# No model endpoint = explicitly labelled local demo mode.
HOST=127.0.0.1
PORT=8080
NEXAMIRO_DATA_DIR=./data

# Required before binding to a non-loopback address. Use a long random token.
# ACCESS_TOKEN=

# An OpenAI-compatible endpoint; include /v1 when your provider requires it.
# Example for a separately installed Ollama service:
# MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_API_KEY=
# MODEL_GENERAL=your-installed-model
# MODEL_REASONING=your-installed-reasoning-model
# MODEL_CODING=your-installed-coding-model
# MODEL_TIMEOUT_MS=60000
# MODEL_MAX_TOKENS=1800
# Optional for compatible hybrid models (Together Qwen3.5 supports this).
# Leave unset for providers/models that do not support the reasoning parameter.
# MODEL_REASONING_ENABLED=false
# MODEL_PROVIDER_NAME=Together AI
# COOKIE_SECURE=true

# MCP clients connect to the running API, sharing its knowledge and run history.
# NEXAMIRO_API_URL=http://127.0.0.1:8080
